{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "viberar",
  "version": "1.0.0",
  "identifier": "com.viberar.archiver",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeRAR - High Performance Archive Manager",
        "width": 960,
        "height": 640,
        "minWidth": 700,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
